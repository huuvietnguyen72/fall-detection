# Sao chép thành .env rồi điền:  cp .env.example .env

# ---- MQTT broker (Mosquitto) ----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

BELT_ID=belt01
CAM_ID=cam01

# ---- Telegram (tạo bot qua @BotFather; lấy chat id qua @userinfobot) ----
# Để trống = chế độ DRY-RUN: tin nhắn + ảnh được lưu vào thư mục logs/ thay vì gửi.
# Nhiều người nhận: ngăn cách bằng dấu phẩy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Decision Fusion ----
COUNTDOWN_S=15
STANDING_CONFIRM_S=3
VISION_ONLY_LYING_S=20
MIN_IMPACT_SCORE=0.5
# Hết đếm ngược mà camera không thấy người: warn | sos | ignore
NO_VISION_POLICY=warn

# ---- Vision ----
VISION_BACKEND=mediapipe
# 0 = webcam laptop (1, 2... = camera khác, vd iPhone qua Continuity Camera trên Mac)
# hoặc URL camera điện thoại qua WiFi (app IP Camera Lite / IP Webcam), có mật khẩu thì ghi kèm:
#   CAMERA_SOURCE=http://admin:matkhau@192.168.1.5:8081/video
CAMERA_SOURCE=0
# Luồng video trên dashboard: số ảnh/giây và độ rộng ảnh (px)
PREVIEW_FPS=12
PREVIEW_WIDTH=640

DASHBOARD_PORT=8088
